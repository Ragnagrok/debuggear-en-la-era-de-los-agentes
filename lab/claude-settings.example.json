{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "lab/log.sh --show" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lab/done-gate.sh \"$CLAUDE_PROJECT_DIR/lab/reproduce.sh\" \"the name of your regression test\""
          }
        ]
      }
    ]
  }
}
